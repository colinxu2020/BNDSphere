{
  "name": "bndsphere-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-token-utilities.mjs",
    "check:palette": "node scripts/check-raw-palette.mjs",
    "check:contrast": "node scripts/check-scheme-contrast.mjs",
    "generate:api": "node ./node_modules/openapi-typescript/bin/cli.js openapi.json -o src/api/schema.d.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:tokens && npm run check:palette && npm run check:contrast"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "motion": "^12.23.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1"
  }
}
