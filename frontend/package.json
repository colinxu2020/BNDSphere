{
  "name": "bndsphere-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:tokens": "node scripts/check-token-utilities.mjs",
    "check:palette": "node scripts/check-raw-palette.mjs",
    "verify": "npm run lint && npm run build && npm run check:tokens && npm run check:palette && npm run check:contrast",
    "check:contrast": "node scripts/check-scheme-contrast.mjs",
    "generate:api": "node ./node_modules/openapi-typescript/bin/cli.js openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "motion": "^12.23.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
