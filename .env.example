# Copy to .env (`cp .env.example .env`) — Compose reads it to fill the ${...}
# references in docker-compose*.yml.
#
# Secrets do NOT belong here: they are generated by scripts/gen-secrets.sh into
# files under secrets/ and mounted as Docker secrets (see backend/app/core/settings.py).

# Host port Caddy publishes. Caddy is the only exposed entrypoint and proxies
# /api to the backend.
CADDY_PORT=7777

# Allowed CORS origin; "*" for local development.
CORS_ORIGIN=*

# Object storage (endpoint and bucket names are not secrets; the credentials
# are, and come from Docker secrets).
OSS_ENDPOINT_URL=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=

# Per-IP budgets on /auth/login and /auth/register. OFF by default: a whole
# campus can share one NAT egress IP, so an IP-level block takes out many
# legitimate users at once. Set to true to blunt bulk scanning from a single
# source. The per-account failure lockout and the process-wide circuit breaker
# stay active either way.
AUTH_IP_RATE_LIMIT_ENABLED=false

# Email verification over SMTP. Empty SMTP_HOST disables the channel: /verification
# /email/send then answers 503 in production, and logs the code in debug builds.
# SMTP_PASSWORD is a Docker secret (secrets/smtp_password.txt), not an entry here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Envelope sender; falls back to SMTP_USERNAME when blank.
SMTP_FROM=
SMTP_STARTTLS=true

# Tencent Cloud SMS. All four must be set for the channel to be considered
# configured, alongside the two credential secrets (secrets/tencent_sms_secret_id
# .txt and secrets/tencent_sms_secret_key.txt). The template must take two
# parameters in this order: the code, then how many minutes it stays valid.
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# Optional second template, used for password-reset codes so the message
# says what answering it does. Empty reuses the one above.
TENCENT_SMS_RESET_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
