{
	admin off
	persist_config off
}

:8080 {
	root * /srv
	encode

	handle /api/* {
		reverse_proxy http://backend:8000 {
			# Overwrite (never append to) the peer address so the backend's
			# per-IP rate limiter can trust X-Real-IP. A client-supplied value
			# is replaced here and never reaches the app.
			header_up X-Real-IP {remote_host}
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@staticFiles {
		not path / /index.html
		file {path}
	}
	handle @staticFiles {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		header Cache-Control "public, max-age=0, s-maxage=21600"
		try_files {path} {path}/ /index.html
		file_server
	}
}
